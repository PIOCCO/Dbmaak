# LiveKit (required for voice sessions)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# Agent identity (must match SIP dispatch rule roomConfig.agents[].agentName)
LIVEKIT_AGENT_NAME=voice-receptionist

# OpenAI Realtime (required for voice)
OPENAI_API_KEY=your_openai_api_key

# Default business for local console dev (never trust caller/LLM for tenant id)
DEFAULT_BUSINESS_ID=demo_salon

# Business config directory (YAML profiles)
BUSINESS_CONFIG_DIR=config/businesses

# Database (PostgreSQL in production; sqlite supported for local dev)
DATABASE_URL=postgresql+psycopg://receptionist:receptionist@localhost:5432/receptionist
# DATABASE_URL=sqlite+pysqlite:///./receptionist.db

# Observability
LOG_LEVEL=INFO
LOG_JSON=false
OTEL_EXPORTER_OTLP_ENDPOINT=

# Call metadata retention (days); 0 disables persistence cleanup scheduling
CALL_METADATA_RETENTION_DAYS=90

# Privacy: never log full transcripts by default
LOG_TRANSCRIPTS=false

# Telephony routing: JSON map of E.164 called number -> business_id
# Example: {"+15551234567":"demo_salon","+15559876543":"demo_clinic"}
PHONE_NUMBER_BUSINESS_MAP={}

# Human handoff SIP URI or E.164 (provider-specific); used by request_human_handoff
HUMAN_HANDOFF_DESTINATION=

# Optional integration tests (skipped unless set)
RUN_LIVEKIT_INTEGRATION=false
